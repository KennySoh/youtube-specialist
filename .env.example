# Copy to .env to change the defaults. Keep comments on their own lines (Docker reads this file too).
# YouTube requests per day: one per video, channel listing or video lookup. ~50 held up in practice.
YT_DAILY_LIMIT=50
# Random pause between caption requests, in seconds.
YT_GAP_MIN=60
YT_GAP_MAX=120
# Folder with the book PDFs (./scripts/books.sh). Default: raw/books
# BOOKS_DIR=/home/you/books
