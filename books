#!/usr/bin/env bash
# ./books [slug ...] [--force]   convert the PDFs in knowledge/books.txt into knowledge/<slug>/chapters/
# PDFs are read from $BOOKS_DIR (default ~/books), mounted read-only.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
if [[ -f .env ]]; then set -a; source .env; set +a; fi
BOOKS_DIR="${BOOKS_DIR:-$HOME/books}"
[[ -d "$BOOKS_DIR" ]] || { echo "No PDF folder at $BOOKS_DIR (set BOOKS_DIR in .env)" >&2; exit 1; }
docker build -q -t pdf2md pdf2md >/dev/null
exec docker run --rm -t -u "$(id -u):$(id -g)" -v "$PWD:/repo" -v "$BOOKS_DIR:/books:ro" pdf2md "$@"
